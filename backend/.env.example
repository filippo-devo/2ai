# Skopiuj ten plik do .env i wpisz swój klucz API Anthropic.
# Klucz jest używany WYŁĄCZNIE przez ten lokalny serwer – nigdy nie trafia do aplikacji mobilnej.
ANTHROPIC_API_KEY=

# Opcjonalnie: model (domyślnie claude-opus-5-5). Tańsze alternatywy: claude-sonnet-5-5, claude-haiku-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# Opcjonalnie: port serwera (domyślnie 3001)
# PORT=3001
